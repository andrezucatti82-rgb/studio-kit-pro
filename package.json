{
  "name": "video-multimarcas-kit",
  "version": "2.16.1",
  "private": true,
  "type": "module",
  "description": "Brand-adaptive B-roll agent skill and editable production starter",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio src/index.tsx",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/render.mjs --stills",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node scripts/test-python.mjs",
    "new": "node scripts/new-project.mjs",
    "validate": "node scripts/validate.mjs",
    "review": "node scripts/review.mjs",
    "doctor": "node scripts/doctor.mjs",
    "atlas": "node scripts/serve-atlas.mjs",
    "identity-check": "node scripts/identity-check.mjs",
    "plan": "node scripts/production-plan.mjs",
    "fidelity-check": "node scripts/fidelity-check.mjs",
    "production": "node scripts/production.mjs",
    "production:serve": "node scripts/serve-production.mjs",
    "production:poc": "node scripts/production.mjs --engineering-poc --root projects/orchestrator-poc",
    "video": "node scripts/video.mjs",
    "video:inspect": "node scripts/inspect-media.mjs",
    "setup:verify": "node scripts/setup-check.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "package": "node scripts/build-search-index.mjs && python3 scripts/package-skill.py && python3 scripts/package-installer.py",
    "audit:prompts": "node scripts/audit-style-prompts.mjs",
    "tools:plan": "node scripts/free-tools.mjs plan",
    "tools:doctor": "node scripts/free-tools.mjs doctor",
    "tools:install": "node scripts/free-tools.mjs install",
    "tools:smoke": "node scripts/free-tools.mjs smoke",
    "tools:run": "node scripts/free-tools.mjs run",
    "curadoria": "node tools/curadoria/cli.mjs",
    "heygen:models": "node scripts/heygen-models.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "linkedom": "^0.18.12",
    "typescript": "5.9.3"
  }
}
